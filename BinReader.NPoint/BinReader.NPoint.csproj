<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>A .NET client for reading and caching JSON bins from https://www.npoint.io/</Description>
        <Copyright>Robin Claesson</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RobinClaesson/BinReader.NPoint</RepositoryUrl>
        <PackageId>BinReader.NPoint</PackageId>
        <Authors>RobinClaesson</Authors>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BinReader.NPoint.Tests"/>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14"/>
    </ItemGroup>

</Project>
